GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_URL=

# MongoDB (required for auth: login, OTP, users, saved prescriptions)
MONGODB_URI=
MONGODB_DB_NAME=

# JWT secret for auth tokens (set a strong value in production)
JWT_SECRET=

# Email OTP (SMTP) — required to send OTP by email; if unset, OTP is returned in API response (dev only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Supabase (required for medicines data only; auth uses MongoDB above)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Optional: Veryfi Medical Prescription OCR API (commercial, high accuracy)
# Sign up at https://www.veryfi.com/ for free trial
# VERYFI_CLIENT_ID=your_client_id
# VERYFI_CLIENT_SECRET=your_client_secret
# VERYFI_USERNAME=your_username
# VERYFI_API_KEY=your_api_key
